generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workAddress   String?
  workLatitude  Float?
  workLongitude Float?
  avatarUrl     String?
  showOnMap     Boolean @default(false)

  sessions      Session[]
  accounts      Account[]
  createdEvents Event[]
  eventParticipations EventParticipant[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  datetime    DateTime

  placeName      String
  placeAddress   String
  placeLatitude  Float
  placeLongitude Float

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator      User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  participants EventParticipant[]

  @@map("event")
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String
  status  String @default("invited")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participant")
}
